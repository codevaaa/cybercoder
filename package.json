{
  "name": "cybercoder-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CyberCoder CLI — Advanced AI-powered command-line interface, better than Claude Code",
  "homepage": "https://codevaaa.github.io/codeva",
  "repository": {
    "type": "git",
    "url": "https://github.com/codevaaa/codeva"
  },
  "license": "MIT",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present run build",
    "dev": "pnpm --filter @cybermind/cli run dev",
    "cli": "pnpm --filter @cybermind/cli run dev",
    "typecheck": "corepack pnpm -r --parallel --if-present run typecheck",
    "lint": "eslint .",
    "test": "corepack pnpm -r --parallel --if-present run test",
    "self-check": "corepack pnpm typecheck && corepack pnpm test",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky install || true",
    "ci": "pnpm install --frozen-lockfile && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^14.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "form-data": "4.0.6",
      "esbuild": "0.28.2",
      "@vscode/vsce>glob": "14.0.2",
      "@vscode/vsce>minimatch": "11.0.1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
